# Hostname the backend answers on in Cloudflare (public hostname in the Tunnel).
# Must match the Public Hostname configured in the CF Tunnel dashboard.
API_DOMAIN=api.qrshield.example.com

# Allowed origin for CORS — the web frontend's URL (no trailing slash).
# Use "*" during early testing if the frontend host isn't stable yet.
FRONTEND_ORIGIN=https://qrshield.example.com

# Cloudflare Tunnel token. Copy from the Cloudflare dashboard:
#   Zero Trust → Networks → Tunnels → <your tunnel> → Install connector → Docker.
# Treat as a secret; never commit this file (keep .env in .gitignore).
TUNNEL_TOKEN=eyJhIjoi...paste-your-token-here

# --- Threat intel API keys (each optional — leave blank to skip that source) ---
# Google Cloud Console → APIs & Services → Credentials → Create API key, then
# enable "Safe Browsing API". Free quota: 10 000 req/day.
GOOGLE_SAFE_BROWSING_KEY=

# abuse.ch single Auth-Key unlocks URLhaus AND ThreatFox. Register for free:
#   https://auth.abuse.ch/user/signup
ABUSE_CH_AUTH_KEY=

# PhishTank app key. Register for free: https://phishtank.org/api_register.php
PHISHTANK_API_KEY=

# AlienVault OTX. Register for free: https://otx.alienvault.com/
OTX_API_KEY=
